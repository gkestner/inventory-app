// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  EMPLOYEE
  MAINTENANCE
  MANAGER
  ADMIN
}

enum Permission {
  // ===== App Navigation / Modules =====
  VIEW_HOME

  VIEW_CHECKOUT
  CREATE_CHECKOUT
  VIEW_INVENTORY
  VIEW_ROOM_DIAGRAMS
  EDIT_QUICK_COUNT

  VIEW_WORK_ORDERS
  CREATE_WORK_ORDERS
  CREATE_WORK_ORDERS_FOR_OTHERS
  UPDATE_OWN_WORK_ORDERS
  SUBMIT_OWN_WORK_ORDERS

  // ✅ NEW: Live Orders board (general users)
  VIEW_LIVE_ORDERS

  VIEW_PREVENTATIVE_MAINTENANCE
  VIEW_EQUIPMENT_TRACKING
  VIEW_COMPANY_VEHICLE_LOG
  CREATE_COMPANY_VEHICLE_INFO
  EDIT_COMPANY_VEHICLE_INFO
  VIEW_MAINTENANCE_REQUESTS
  VIEW_TEMPERATURE_DASHBOARD
  VIEW_RECEIPTS
  CREATE_RECEIPTS

  // ===== Admin Modules =====
  ADMIN_VIEW_ITEMS
  ADMIN_EDIT_ITEMS
  ADMIN_IMPORT_EXPORT_ITEMS

  ADMIN_VIEW_USERS
  ADMIN_EDIT_USERS

  ADMIN_VIEW_LOCATIONS
  ADMIN_EDIT_LOCATIONS

  ADMIN_VIEW_WORK_ORDERS
  ADMIN_EDIT_WORK_ORDERS
  ADMIN_DELETE_WORK_ORDERS

  ADMIN_VIEW_MAINTENANCE_TICKETS
  ADMIN_EXPORT_MAINTENANCE_TICKETS

  ADMIN_VIEW_PREVENTATIVE_MAINTENANCE
  ADMIN_VIEW_EQUIPMENT_TRACKING
  ADMIN_VIEW_COMPANY_VEHICLES
  ADMIN_VIEW_MAINTENANCE_REQUESTS
  ADMIN_VIEW_TEMPERATURE_DASHBOARD

  ADMIN_VIEW_REPORT_SLA_BREACHES
  ADMIN_VIEW_REPORT_TECHNICIAN_WORKLOAD
  ADMIN_VIEW_REPORT_TEMPERATURE_INCIDENTS
  ADMIN_VIEW_REPORT_PM_COMPLIANCE
  ADMIN_VIEW_REPORT_PARTS_CONSUMPTION_COSTS
  ADMIN_VIEW_REPORT_FLEET_TCO
  ADMIN_VIEW_REPORT_PERMISSION_COVERAGE
  ADMIN_VIEW_REPORT_NOTIFICATION_EFFECTIVENESS

  // ===== Notification Routing =====
  RECEIVE_NOTIFICATION_MAINTENANCE_REQUESTS
  RECEIVE_NOTIFICATION_TEMPERATURE_ALERTS
  RECEIVE_NOTIFICATION_WORK_ORDER_SCHEDULES
  RECEIVE_NOTIFICATION_CYCLE_COUNTS
}

enum InvoiceVendor {
  SUCCESS_PLUS
  AMERICAN_PLUS
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOIDED
}

enum InventoryAlertType {
  NEGATIVE_ON_HAND
  BELOW_MIN
  TECH_REQUEST_ORDER
}

enum PartsCheckoutStatus {
  OPEN
  INVOICED
  VOIDED
}

/**
 * =========================
 * Permission Titles (RBAC)
 * =========================
 *
 * Purpose:
 * - Let admins create "privilege titles" in-app (e.g., "Maintenance", "Inventory Clerk")
 * - Attach Permission enum values via checkboxes
 * - Assign one or more titles to each user
 * - Keep existing UserPermission for per-user overrides (optional)
 */
model PermissionTitle {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions PermissionTitlePermission[]
  users       UserPermissionTitle[]

  // ✅ NEW: roles can reference titles (role grants title permissions)
  roleLinks AppRolePermissionTitle[]

  @@index([active])
}

model PermissionTitlePermission {
  titleId    String
  permission Permission

  title PermissionTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([titleId, permission])
  @@index([permission])
  @@index([titleId])
}

model UserPermissionTitle {
  userId  String
  titleId String

  assignedAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title PermissionTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([userId, titleId])
  @@index([userId])
  @@index([titleId])
}

/**
 * =========================
 * Dynamic Roles (RBAC)
 * =========================
 *
 * - Admins can create roles in-app (no migrations).
 * - Users can have 0..N roles.
 * - Roles can grant permissions directly and/or via PermissionTitles.
 * - Keep existing User.role enum for compatibility during rollout.
 */
model AppRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // seed roles like ADMIN/MANAGER/etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions AppRolePermission[]
  titles      AppRolePermissionTitle[]

  @@index([isSystem])
}

model UserRole {
  userId String
  roleId String

  assignedAt DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model AppRolePermission {
  roleId     String
  permission Permission

  assignedAt DateTime @default(now())

  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([permission])
  @@index([roleId])
}

model AppRolePermissionTitle {
  roleId  String
  titleId String

  assignedAt DateTime @default(now())

  role  AppRole         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  title PermissionTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([roleId, titleId])
  @@index([roleId])
  @@index([titleId])
}

/**
 * =========================
 * Work Orders
 * =========================
 */
enum WorkOrderStatus {
  DRAFT
  SUBMITTED
  FINALIZED
}

enum WorkOrderPingEvent {
  STARTED
  STOPPED
  EDITED
}

enum NotificationType {
  WORK_ORDER
  SCHEDULER
  CYCLE_COUNT
  SYSTEM
  TEMPERATURE_ALERT
}

enum TemperatureAlertState {
  NORMAL
  HIGH
  LOW
  UNKNOWN
}

enum CycleCountSessionStatus {
  OPEN
  CLOSED
}

enum VehicleMileageSource {
  MANUAL
  WORK_ORDERS_BY_ASSIGNED_USER
}

enum VehicleReminderType {
  TIME_BASED
  MILEAGE_BASED
}

enum MaintenanceRequestStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

/**
 * Expanded enum:
 * - Includes the REQUIRED pizza-maintenance areas (used by UI)
 * - ALSO includes legacy values that already exist in DB (e.g. KITCHEN)
 * to prevent runtime crashes when reading historical rows.
 */
enum EquipmentArea {
  // --- REQUIRED (pizza list) ---
  DOUGH_ROLLER
  MAKETABLE
  DOUGH_COOLER
  MIXER
  OVEN
  WALK_IN
  FREEZER
  BUILDING_STRUCTURE
  GENERAL_BUILDING_MAINTENANCE
  GREASE_TRAPS
  EQUIPMENT_FILTERS
  LIGHTING
  PARKING_LOT
  OFFICE
  PLUMBING
  HVAC_GAME_ROOM
  HVAC_KITCHEN
  HVAC_DINING_ROOM
  OTHER

  // --- LEGACY (previous enum values found in DB) ---
  FRONT_COUNTER
  DRIVE_THRU
  KITCHEN
  ROOF
  HVAC
}

/**
 * =========================
 * Inventory Orders (Order History)
 * =========================
 */
enum InventoryOrderStatus {
  ORDERED
  ARRIVED
  ADDED_TO_INVENTORY
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  receiptEnabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Primary/default location relation (User.locationId)
  users User[]

  // Per-user location assignments (primary + optional, ordered)
  userLocations UserLocation[]

  checkouts PartsCheckoutTicket[]

  // Work Orders
  workOrders WorkOrder[]

  // Inventory Orders (optional “for store”)
  inventoryOrdersForStore InventoryOrder[] @relation("InventoryOrderForStore")

  // Store number used for invoicing (nullable for safe rollout)
  locationNumber String? @unique

  // Corporation number (optional, per location)
  corporationNumber String?

  // Invoices per store
  invoices Invoice[]

  // Admin-only work order activity pings
  workOrderPings WorkOrderPing[]

  // Scheduling / counts
  pmSchedules        PmSchedule[]
  preventativeMaintenanceEntries PreventativeMaintenanceEntry[]
  equipmentTrackingLogs EquipmentTrackingLog[]
  cycleCountSessions CycleCountSession[]
  maintenanceRequests MaintenanceRequest[]
  mocreoHubs MocreoHub[]
  receiptEntries ReceiptEntry[]

  @@index([active])
  @@index([receiptEnabled])
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String
  role         Role   @default(EMPLOYEE)

  // Primary/default location (legacy single value; keep for compatibility)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // Per-user locations (primary + optional, ordered)
  allowedLocations UserLocation[]

  // granular permissions (admins treated allow-all in code)
  permissions UserPermission[]

  // ✅ RBAC titles assigned to user (one or many)
  permissionTitles UserPermissionTitle[]

  // ✅ NEW: dynamic roles assigned to user (0..N)
  roles UserRole[]

  // Self-service password reset via security question
  securityQuestionsEnabled   Boolean @default(false)
  securityQuestionPrompt     String?
  securityQuestionAnswerHash String?
  uiPreferences              Json?
  nextWorkOrderStartingMileage Int?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  createdCheckouts PartsCheckoutTicket[] @relation("CheckoutCreatedBy")
  resolvedAlerts   InventoryAlert[]      @relation("AlertResolvedBy")
  createdAlerts    InventoryAlert[]      @relation("AlertCreatedBy")

  // Work Orders
  workOrdersCreated WorkOrder[] @relation("WorkOrderCreatedBy")
  workOrdersUpdated WorkOrder[] @relation("WorkOrderUpdatedBy")
  workOrderPings   WorkOrderPing[] @relation("WorkOrderPingActor")

  // Inventory Orders
  inventoryOrdersCreated InventoryOrder[] @relation("InventoryOrderCreatedBy")
  inventoryOrdersForUser InventoryOrder[] @relation("InventoryOrderForUser")

  // Invoices created/issued by admins
  invoicesCreated Invoice[] @relation("InvoiceCreatedBy")

  // Reporting / workflow additions
  notifications      Notification[]
  savedViews         SavedView[]
  auditLogs          AuditLog[]
  attachmentsAdded   WorkOrderAttachment[] @relation("WorkOrderAttachmentAddedBy")
  pmSchedulesCreated PmSchedule[]          @relation("PmScheduleCreatedBy")
  pmSchedulesAssigned PmSchedule[]         @relation("PmScheduleDefaultUser")
  preventativeMaintenanceEntriesUpdated PreventativeMaintenanceEntry[] @relation("PreventativeMaintenanceEntryUpdatedBy")
  equipmentTrackingLogsUpdated EquipmentTrackingLog[] @relation("EquipmentTrackingLogUpdatedBy")
  assignedCompanyVehicles CompanyVehicle[] @relation("CompanyVehicleAssignedUser")
  createdVehicleReminders VehicleMaintenanceReminder[] @relation("VehicleReminderCreatedBy")
  updatedVehicleReminders VehicleMaintenanceReminder[] @relation("VehicleReminderUpdatedBy")
  performedVehicleServices CompanyVehicleServiceLog[] @relation("VehicleServicePerformedBy")
  createdVehicleServices CompanyVehicleServiceLog[] @relation("VehicleServiceCreatedBy")
  cycleCountsCreated CycleCountSession[]   @relation("CycleCountCreatedBy")
  maintenanceRequestsCreated MaintenanceRequest[] @relation("MaintenanceRequestCreatedBy")
  maintenanceRequestsAssigned MaintenanceRequest[] @relation("MaintenanceRequestAssignedTo")
  maintenanceRequestAssignments MaintenanceRequestAssignee[]
  maintenanceRequestsResolved MaintenanceRequest[] @relation("MaintenanceRequestResolvedBy")
  assignedMocreoHubs MocreoHub[] @relation("MocreoHubAssignedMaintenanceUser")
  mocreoHubRecipients MocreoHubRecipient[]
  receiptEntriesCreated ReceiptEntry[] @relation("ReceiptEntryCreatedBy")
  receiptFilesUploadedBy ReceiptFile[] @relation("ReceiptFilesUploadedBy")
  inventoryItemComments InventoryItemComment[]
}

model UserPermission {
  id         String     @id @default(cuid())
  userId     String
  permission Permission

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([permission])
  @@index([userId])
}

model UserLocation {
  id         String @id @default(cuid())
  userId     String
  locationId String
  sortOrder  Int    @default(0)

  // allow multiple primary locations per user
  isPrimary Boolean @default(false)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([userId, isPrimary, sortOrder])
  @@index([userId, sortOrder])
  @@index([locationId])
}

model WorkOrder {
  id     String          @id @default(cuid())
  status WorkOrderStatus @default(DRAFT)

  workOrderNumber String?   @unique
  generatedAt     DateTime?

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  startTime DateTime?
  endTime   DateTime?

  startingMileage Int?
  endingMileage   Int?

  notes String?

  createdByUserId String
  createdByUser   User @relation("WorkOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  updatedByUserId String?
  updatedByUser   User? @relation("WorkOrderUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipmentAreas WorkOrderEquipmentArea[]
  checklistSelections WorkOrderChecklistSelection[]
  pings          WorkOrderPing[]
  attachments    WorkOrderAttachment[]
  auditLogs      AuditLog[]

  @@index([status, createdAt])
  @@index([locationId, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([generatedAt])
}

model PmSchedule {
  id String @id @default(cuid())

  title          String
  description    String?
  locationId     String
  location       Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  defaultUserId  String?
  defaultUser    User?    @relation("PmScheduleDefaultUser", fields: [defaultUserId], references: [id], onDelete: SetNull)
  intervalDays   Int
  active         Boolean  @default(true)
  lastGeneratedAt DateTime?
  nextDueAt      DateTime

  createdByUserId String
  createdByUser   User @relation("PmScheduleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, nextDueAt])
  @@index([locationId, active])
}

model PreventativeMaintenanceEntry {
  id String @id @default(cuid())

  year       Int
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  ovenCleaning       String?
  exhaustFanMotor    String?
  tanklessWaterHeater String?
  iceMaker           String?
  greaseTrapGallons  String?

  greaseTrapTankSize String?
  greaseTrapDatePumped String?
  greaseTrapReminderMonths String?
  greaseTrapCompany  String?
  greaseTrapCost     String?

  backflowDateChecked String?
  backflowReminderMonths String?
  backflowCompany    String?
  backflowAmount     String?

  boilerInspectionDatePrimary String?
  boilerInspectionReminderMonths String?
  boilerInspectionCompany String?
  boilerInspectionCost String?
  boilerInspectionDateSecondary String?

  updatedByUserId String?
  updatedByUser   User? @relation("PreventativeMaintenanceEntryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, year])
  @@index([year])
  @@index([updatedByUserId])
}

model EquipmentTrackingLog {
  id String @id @default(cuid())

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  sectionKey String

  ngOrLp            String?
  iceCream          String?
  greaseTrapSize    String?
  modelNumber       String?
  serialNumber      String?
  manufacturer      String?
  color             String?
  freonType         String?
  notes             String?
  pepsiMachineOrBin String?
  tanklessOrTank    String?
  condenserUnitNumber String?
  evaporatorUnitNumber String?
  tonnage           String?
  size              String?
  freezerType       String?
  letterSize        String?
  signType          String?
  amountOfHeads     String?
  cameraCount       String?
  lpOrNg            String?

  updatedByUserId String?
  updatedByUser   User? @relation("EquipmentTrackingLogUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, sectionKey])
  @@index([sectionKey])
  @@index([updatedByUserId])
}

model EquipmentAreaChecklistItem {
  id String @id @default(cuid())

  area String
  label String
  sortOrder Int @default(0)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrderSelections WorkOrderChecklistSelection[]

  @@index([area, active, sortOrder])
  @@index([area, label])
}

model WorkOrderEquipmentCategory {
  key String @id
  label String
  sortOrder Int @default(0)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder, label])
}

model CompanyVehicle {
  id String @id @default(cuid())

  name         String
  vinNumber    String?
  licensePlate String?
  active       Boolean @default(true)

  mileageSource VehicleMileageSource @default(MANUAL)
  currentMileage Int?

  assignedUserId String?
  assignedUser   User? @relation("CompanyVehicleAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders   VehicleMaintenanceReminder[]
  serviceLogs CompanyVehicleServiceLog[]

  @@index([active, name])
  @@index([assignedUserId, active])
}

model VehicleMaintenanceReminder {
  id String @id @default(cuid())

  vehicleId String
  vehicle   CompanyVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  title       String
  description String?
  reminderType VehicleReminderType

  intervalDays  Int?
  intervalMiles Int?

  lastCompletedAt      DateTime?
  lastCompletedMileage Int?

  active Boolean @default(true)

  createdByUserId String
  createdByUser   User @relation("VehicleReminderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  updatedByUserId String?
  updatedByUser   User? @relation("VehicleReminderUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceLogs CompanyVehicleServiceLog[]

  @@index([vehicleId, active])
  @@index([reminderType, active])
}

model CompanyVehicleServiceLog {
  id String @id @default(cuid())

  vehicleId String
  vehicle   CompanyVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  reminderId String?
  reminder   VehicleMaintenanceReminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  serviceAt DateTime
  odometer  Int?

  serviceType   String?
  description   String
  vendor        String?
  cost          Decimal? @db.Decimal(10, 2)

  performedByUserId String?
  performedByUser   User? @relation("VehicleServicePerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)

  createdByUserId String
  createdByUser   User @relation("VehicleServiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, serviceAt])
  @@index([reminderId])
  @@index([performedByUserId, serviceAt])
  @@index([createdByUserId, serviceAt])
}

model MaintenanceRequest {
  id String @id @default(cuid())

  status MaintenanceRequestStatus @default(OPEN)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  title       String
  description String

  requestedByUserId String
  requestedByUser   User @relation("MaintenanceRequestCreatedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  assignedMaintenanceUserId String?
  assignedMaintenanceUser   User? @relation("MaintenanceRequestAssignedTo", fields: [assignedMaintenanceUserId], references: [id], onDelete: SetNull)
  maintenanceAssignees MaintenanceRequestAssignee[]

  resolutionNotes String?
  resolvedAt      DateTime?

  resolvedByUserId String?
  resolvedByUser   User? @relation("MaintenanceRequestResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  @@index([status, createdAt])
  @@index([locationId, status])
  @@index([requestedByUserId, createdAt])
  @@index([assignedMaintenanceUserId, status])
  @@index([resolvedByUserId, resolvedAt])
}

model MaintenanceRequestAssignee {
  id String @id @default(cuid())

  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([requestId, userId])
  @@index([requestId])
  @@index([userId])
}

model MocreoHub {
  id String @id @default(cuid())

  name          String
  externalHubId String @unique
  active        Boolean @default(true)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  assignedMaintenanceUserId String?
  assignedMaintenanceUser   User? @relation("MocreoHubAssignedMaintenanceUser", fields: [assignedMaintenanceUserId], references: [id], onDelete: SetNull)

  minTempF Decimal? @db.Decimal(6, 2)
  maxTempF Decimal? @db.Decimal(6, 2)

  gaugeMinF Decimal? @db.Decimal(6, 2)
  gaugeMaxF Decimal? @db.Decimal(6, 2)

  lastReadingAt DateTime?
  lastTempF     Decimal? @db.Decimal(6, 2)

  lastAlertState TemperatureAlertState?
  lastAlertAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients MocreoHubRecipient[]
  devices    MocreoDevice[]
  readings   MocreoTemperatureReading[]

  @@index([active, name])
  @@index([locationId, active])
  @@index([assignedMaintenanceUserId, active])
}

model MocreoHubRecipient {
  hubId  String
  userId String

  hub  MocreoHub @relation(fields: [hubId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@id([hubId, userId])
  @@index([userId])
}

model MocreoDevice {
  id String @id @default(cuid())

  hubId String
  hub   MocreoHub @relation(fields: [hubId], references: [id], onDelete: Cascade)

  name             String
  externalDeviceId String

  minTempF Decimal? @db.Decimal(6, 2)
  maxTempF Decimal? @db.Decimal(6, 2)

  lastSeenAt      DateTime?
  lastReadingAt   DateTime?
  lastTempF       Decimal? @db.Decimal(6, 2)
  lastBatteryPct  Int?
  lastSignalPct   Int?
  lastAlertState  TemperatureAlertState?
  lastRawPayload  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  readings MocreoTemperatureReading[]

  @@unique([hubId, externalDeviceId])
  @@index([hubId, name])
}

model MocreoTemperatureReading {
  id String @id @default(cuid())

  hubId String
  hub   MocreoHub @relation(fields: [hubId], references: [id], onDelete: Cascade)

  deviceId String?
  device   MocreoDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  externalReadingId String?
  recordedAt        DateTime
  tempF             Decimal? @db.Decimal(6, 2)
  batteryPct        Int?
  signalPct         Int?
  alertState        TemperatureAlertState @default(UNKNOWN)
  rawPayload        Json?

  notificationSentAt DateTime?

  createdAt DateTime @default(now())

  @@index([hubId, recordedAt])
  @@index([deviceId, recordedAt])
  @@index([alertState, recordedAt])
  @@index([externalReadingId])
}

model AuditLog {
  id String @id @default(cuid())

  actorUserId String?
  actorUser   User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  module      String
  action      String
  entityType  String
  entityId    String?
  message     String?
  metadata    Json?

  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([module, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([workOrderId, createdAt])
}

model SavedView {
  id String @id @default(cuid())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module   String
  name     String
  query    Json
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, module, name])
  @@index([userId, module])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType @default(SYSTEM)
  title   String
  body    String?
  href    String?
  readAt  DateTime?
  emailedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model WorkOrderAttachment {
  id String @id @default(cuid())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  addedByUserId String?
  addedByUser   User? @relation("WorkOrderAttachmentAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  fileName    String
  contentType String?
  byteSize    Int?
  storageKey  String?
  url         String

  createdAt DateTime @default(now())

  @@index([workOrderId, createdAt])
}

model CycleCountSession {
  id String @id @default(cuid())

  name        String
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  status      CycleCountSessionStatus @default(OPEN)
  notes       String?

  createdByUserId String
  createdByUser   User @relation("CycleCountCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  closedAt  DateTime?

  items CycleCountItem[]

  @@index([locationId, status, createdAt])
}

model CycleCountItem {
  id String @id @default(cuid())

  sessionId String
  session   CycleCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  itemId String
  item   Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  expectedQty Int
  countedQty  Int
  varianceQty Int
  notes       String?

  createdAt DateTime @default(now())

  @@unique([sessionId, itemId])
  @@index([sessionId, varianceQty])
}

model WorkOrderPing {
  id String @id @default(cuid())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  actorUserId String
  actorUser   User @relation("WorkOrderPingActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  event WorkOrderPingEvent
  note  String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([locationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([workOrderId, createdAt])
}

model WorkOrderEquipmentArea {
  workOrderId String
  area        String

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@id([workOrderId, area])
}

model WorkOrderChecklistSelection {
  workOrderId String
  checklistItemId String
  labelSnapshot String
  area String

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  checklistItem EquipmentAreaChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)

  @@id([workOrderId, checklistItemId])
  @@index([checklistItemId])
  @@index([area])
}

model ReceiptEntry {
  id String @id @default(cuid())

  receiptDate DateTime

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  amountCents Int
  notes       String?
  billedBackVendor String?

  createdByUserId String
  createdByUser   User @relation("ReceiptEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas ReceiptEntryArea[]
  files ReceiptFile[] @relation("ReceiptFiles")

  @@index([receiptDate, createdAt])
  @@index([locationId, receiptDate])
  @@index([createdByUserId, createdAt])
}

model ReceiptEntryArea {
  receiptEntryId String
  area           String

  receiptEntry ReceiptEntry @relation(fields: [receiptEntryId], references: [id], onDelete: Cascade)

  @@id([receiptEntryId, area])
}

model ReceiptFile {
  id String @id @default(cuid())

  receiptEntryId String
  receiptEntry   ReceiptEntry @relation("ReceiptFiles", fields: [receiptEntryId], references: [id], onDelete: Cascade)

  fileName    String
  contentType String?
  byteSize    Int?
  storageKey  String?
  url         String
  
  uploadedByUserId String
  uploadedByUser   User @relation("ReceiptFilesUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([receiptEntryId])
  @@index([uploadedByUserId])
  @@index([createdAt])
}

/**
 * =========================
 * Inventory Orders (Order History)
 * =========================
 */
model InventoryOrder {
  id     String               @id @default(cuid())
  status InventoryOrderStatus @default(ORDERED)

  // ✅ NEW: Admin can hide from the general-user Live Orders board
  hiddenFromUserLiveBoard Boolean @default(false)

  // Vendor for this order (can differ from the item's default vendor)
  vendor InvoiceVendor @default(SUCCESS_PLUS)

  itemId String
  item   Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity Int

  supplierName       String?
  supplierPartNumber String?

  unitPrice    Decimal? @db.Decimal(10, 2)
  shippingCost Decimal? @db.Decimal(10, 2)
  taxCost      Decimal? @db.Decimal(10, 2)

  orderedAt          DateTime  @default(now())
  arrivedAt          DateTime?
  addedToInventoryAt DateTime?

  forStoreId String?
  forStore   Location? @relation("InventoryOrderForStore", fields: [forStoreId], references: [id], onDelete: SetNull)

  forUserId String?
  forUser   User? @relation("InventoryOrderForUser", fields: [forUserId], references: [id], onDelete: SetNull)

  createdByUserId String
  createdByUser   User @relation("InventoryOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, orderedAt])
  @@index([vendor, orderedAt])
  @@index([itemId, orderedAt])
  @@index([forStoreId, orderedAt])
  @@index([forUserId, orderedAt])
  @@index([createdByUserId, orderedAt])

  // ✅ Added for faster supplier filtering + reporting
  @@index([supplierName])
  @@index([supplierPartNumber])

  // Helpful for filtering quickly
  @@index([hiddenFromUserLiveBoard, orderedAt])
}

model Item {
  id  String @id @default(cuid())
  labelNumber Int @unique @default(autoincrement())
  sku String @unique

  partNumber String?

  // Default vendor used for ordering + invoicing unless overridden
  vendor InvoiceVendor @default(SUCCESS_PLUS)

  name        String
  description String?
  category    String?
  cost        Decimal? @db.Decimal(10, 2)
  price       Decimal? @db.Decimal(10, 2)
  taxable     Boolean  @default(true)
  active      Boolean  @default(true)

  manufacturer String?
  orderFrom    String?
  webUrl       String?

  onHandQty  Int @default(0)
  orderedQty Int @default(0)
  usedQty    Int @default(0)
  minQty     Int @default(0)
  reorderIgnored Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions  ItemVersion[]
  alerts    InventoryAlert[]
  checkouts PartsCheckoutTicket[]
  cycleCountItems CycleCountItem[]

  inventoryOrders InventoryOrder[]
  inventoryItemComments InventoryItemComment[]

  @@index([updatedAt])
  @@index([vendor])
  @@index([name])
  @@index([category])
  @@index([manufacturer])
  @@index([orderFrom])
  @@index([reorderIgnored])
}

model InventoryItemComment {
  id String @id @default(cuid())

  itemId String
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  comment String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, userId])
  @@index([itemId, updatedAt])
  @@index([userId, updatedAt])
}

model ItemVersion {
  id String @id @default(cuid())

  itemId String
  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  sku        String
  partNumber String?

  // ✅ FIX: default allows migration to backfill existing rows
  vendor InvoiceVendor @default(SUCCESS_PLUS)

  name        String
  description String?
  category    String?
  unit        String?
  cost        Decimal? @db.Decimal(10, 2)
  price       Decimal? @db.Decimal(10, 2)
  taxable     Boolean
  active      Boolean

  manufacturer String?
  orderFrom    String?
  webUrl       String?

  onHandQty  Int @default(0)
  orderedQty Int @default(0)
  usedQty    Int @default(0)
  minQty     Int @default(0)

  version   Int
  createdAt DateTime @default(now())

  @@unique([itemId, version])
}

model InventoryAlert {
  id   String             @id @default(cuid())
  type InventoryAlertType

  itemId String
  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  storeId    String?
  storeName  String?
  checkoutId String?
  checkout   PartsCheckoutTicket? @relation(fields: [checkoutId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdByUser   User? @relation("AlertCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByName   String?

  qtyDelta       Int?
  onHandAfter    Int?
  orderedAfter   Int?
  availableAfter Int?
  minQtyAtTime   Int?

  note      String?
  createdAt DateTime @default(now())

  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedByUser   User? @relation("AlertResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedByName   String?

  @@index([itemId, createdAt])
  @@index([type, createdAt])
  @@index([resolvedAt])
  @@index([checkoutId])
}

model PartsCheckoutTicket {
  id     String              @id @default(cuid())
  status PartsCheckoutStatus @default(OPEN)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  invoiceLine InvoiceLine? @relation("InvoiceLineCheckout")

  itemId String
  item   Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  storeId   String
  store     Location @relation(fields: [storeId], references: [id], onDelete: Restrict)
  storeName String

  quantity        Int
  needToOrderMore Boolean @default(false)

  createdByUserId String
  createdByUser   User @relation("CheckoutCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdByName   String

  note String?

  skuSnapshot        String
  partNumberSnapshot String?
  nameSnapshot       String
  vendorSnapshot     InvoiceVendor @default(SUCCESS_PLUS)
  costSnapshot       Decimal? @db.Decimal(10, 2)
  priceSnapshot      Decimal? @db.Decimal(10, 2)
  taxableSnapshot    Boolean

  createdAt  DateTime  @default(now())
  invoicedAt DateTime?
  voidedAt   DateTime?
  voidNote   String?

  alerts InventoryAlert[]

  @@index([status, createdAt])
  @@index([storeId, createdAt])
  @@index([itemId, createdAt])
  @@index([invoiceId])
  @@index([vendorSnapshot, createdAt])
}

model InvoiceVendorConfig {
  vendor InvoiceVendor @id

  // Percent values stored as whole percent (e.g., 10.00 = 10%)
  partsUpchargePct Decimal @db.Decimal(5, 2) @default(0)

  // Vendor-level price formula (used in invoicing)
  partsPriceFormula String @default("cost * (1 + (partsUpchargePct / 100))")

  taxRatePct Decimal @db.Decimal(5, 2) @default(0)
  taxFormula String  @default("lineSubtotal * (taxRatePct / 100)")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppConfig {
  id String @id

  liveOrdersAddedRetentionDays Int @default(14)
  orderHistoryPerPage          Int @default(25)
  minQtyRampDownMaxReductionPer30DaysPct Int @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Invoice {
  id String @id @default(cuid())

  vendor InvoiceVendor

  vendorNumber String
  billedTo     String

  storeId     String
  store       Location @relation(fields: [storeId], references: [id], onDelete: Restrict)
  storeName   String
  storeNumber String

  periodStart DateTime
  periodEnd   DateTime

  invoiceDate DateTime
  status      InvoiceStatus @default(DRAFT)

  subtotal Decimal @db.Decimal(12, 2)
  taxTotal  Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  createdByUserId String?
  createdByUser   User? @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  issuedAt  DateTime?
  paidAt    DateTime?
  voidedAt  DateTime?
  voidNote  String?

  lines   InvoiceLine[]
  tickets PartsCheckoutTicket[]

  @@index([storeId, invoiceDate])
  @@index([vendor, invoiceDate])
  @@index([status, createdAt])
  @@index([storeId, periodStart, periodEnd])
}

model InvoiceLine {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  checkoutId String              @unique
  checkout   PartsCheckoutTicket @relation("InvoiceLineCheckout", fields: [checkoutId], references: [id], onDelete: Restrict)

  submittedAt DateTime

  sku        String
  partNumber String?
  name       String

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  taxable   Boolean

  lineSubtotal Decimal @db.Decimal(12, 2)
  lineTax      Decimal @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
}

model ImportJob {
  id        String   @id @default(cuid())
  type      String
  createdAt DateTime @default(now())

  total   Int @default(0)
  created Int @default(0)
  updated Int @default(0)
  failed  Int @default(0)

  errors ImportRowError[]
}

model ImportRowError {
  id    String    @id @default(cuid())
  jobId String
  job   ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  rowNumber Int
  sku       String?
  message   String

  createdAt DateTime @default(now())

  @@index([jobId, rowNumber])
}

model PasswordResetRateLimit {
  key String @id

  failedCount     Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  lastAttemptAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blockedUntil])
  @@index([lastAttemptAt])
}
