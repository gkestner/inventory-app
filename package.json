{
  "name": "inventory-app",
  "version": "0.1.16",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "migrate:deploy": "prisma migrate deploy",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:notifications": "tsx --test app/lib/notification-counts.test.ts app/lib/notification-inbox.test.ts app/lib/notification-email.test.ts app/lib/notification-oversight.test.ts",
    "test:reminders": "tsx --test app/lib/reminder-dates.test.ts app/lib/pm-compliance-rules.test.ts app/lib/reminder-auth.test.ts app/lib/notification-reminders.test.ts app/lib/compliance-fields.test.ts",
    "test:history": "tsx --test app/lib/compliance-history.test.ts app/admin/reports/compliance-history/report-data.test.ts app/admin/reports/compliance-history/history-pdf.test.ts",
    "seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@prisma/client": "^6.11.1",
    "@sparticuz/chromium": "^143.0.4",
    "@vercel/blob": "^2.3.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "next": "16.1.4",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "openai": "^6.31.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.58.2",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "prisma": "^6.11.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
